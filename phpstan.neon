parameters:
    level: 9
    phpVersion: 80200
    paths:
        - src
        - tests
        - benchmarks
        - scripts
        - examples
    reportUnmatchedIgnoredErrors: true
    ignoreErrors:
        # Intentional BC: built-in drivers retain deprecated capability interfaces.
        -
            message: '#implements deprecated interface Oeltima\\SimpleQueue\\Contract\\SupportsWorkerId#'
            path: src/Driver/DatabaseQueueDriver.php
        -
            message: '#implements deprecated interface Oeltima\\SimpleQueue\\Contract\\SupportsQueueReconciliation#'
            path: src/Driver/InMemoryQueueDriver.php
        -
            message: '#implements deprecated interface Oeltima\\SimpleQueue\\Contract\\SupportsQueueReconciliation#'
            path: src/Driver/RedisQueueDriver.php
        -
            message: '#Call to method setWorkerId\(\) of deprecated interface#'
            path: src/Worker.php
        -
            message: '#Call to deprecated method setWorkerId\(\)#'
            path: tests/Unit/DatabaseQueueDriverTest.php
        # Predis PHPDoc promises this method, while older runtime clients may omit it.
        -
            identifier: function.alreadyNarrowedType
            path: src/Driver/RedisQueueDriver.php
